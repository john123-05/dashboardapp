{
  "expo": {
    "name": "Liftpictures Dashboard",
    "slug": "dashboardapp",
    "version": "1.5.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "dashboardapp",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.john12305.dashboardapp",
      "buildNumber": "9",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Damit du Logos und Fotos ins Dashboard hochladen kannst.",
        "NSCameraUsageDescription": "Damit du Fotos direkt aufnehmen und ins Dashboard hochladen kannst."
      }
    },
    "android": {
      "package": "com.john12305.dashboardapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "fb8b5a24-9ecc-403d-bd2c-f73062d073f0"
      }
    },
    "owner": "impressrank",
    "plugins": [
      "./plugins/withPodTargets",
      [
        "expo-notifications",
        {
          "color": "#D2561A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Damit du Logos, Overlays und Fotos ins Dashboard hochladen kannst.",
          "cameraPermission": "Damit du Fotos direkt aufnehmen und ins Dashboard hochladen kannst.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
